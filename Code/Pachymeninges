# Call doublets/multiplets
DM16$scDblFinder.score=NA
DM16$scDblFinder.class=NA
#WT = subset(M, orig.ident=='WT')
doubletRate = (1-lambda/(exp(lambda)-1))/2 # take half Poisson rate of multiplets, because homotypic ones are ~undetectable
for(oi in unique(DM16$orig.ident)) {
  stopifnot(oi %in% names(doubletRate))
  
  i = which(DM16$orig.ident == oi)
  obj = DM16[,i]
  
  # scDblFinder with default parameters:
  if(packageVersion('Seurat') >= '5.0.0') {
    sce <- SingleCellExperiment( list(counts=obj[["RNA"]]$counts) )
  } else {
    sce <- SingleCellExperiment( list(counts=obj@assays$RNA@counts) ) # or obj[["RNA"]]@counts
  }
  sce <- scDblFinder(sce, dbr=doubletRate[oi], verbose=T)
  #hist(colData(sce)$scDblFinder.score)
  stopifnot(identical(rownames(colData(sce)),rownames(obj@meta.data)))
  #obj@meta.data = cbind(obj@meta.data, colData(sce)[c('scDblFinder.score','scDblFinder.class')])
  DM16$scDblFinder.score[i] = colData(sce)$scDblFinder.score
  DM16$scDblFinder.class[i] = as.character(colData(sce)$scDblFinder.class)
}
rm(obj, sce, i, oi)

knitr::kable(table(DM16$orig.ident, DM16$scDblFinder.class, useNA='ifany'), caption='After scDblFinder')

